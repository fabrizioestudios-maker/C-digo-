nyEnd = input.string('11:30', 'End', group='Trading Sessions', inline='ny_time')

// Función para convertir string de hora a minutos desde medianoche
timeToMinutes(timeStr) =>
    parts = str.split(timeStr, ':')
    hours = str.tonumber(array.get(parts, 0))
    minutes = str.tonumber(array.get(parts, 1))
    hours * 60 + minutes

// Función para verificar si estamos en una sesión
inSession(sessionStart, sessionEnd) =>
    currentMinutes = hour * 60 + minute
    startMinutes = timeToMinutes(sessionStart)
    endMinutes = timeToMinutes(sessionEnd)
    
    // Manejar sesiones que cruzan medianoche
    if endMinutes < startMinutes
        currentMinutes >= startMinutes or currentMinutes < endMinutes
    else
        currentMinutes >= startMinutes and currentMinutes < endMinutes

// Función para calcular pips
calcPips(priceRange) =>
    pipValue = syminfo.mintick * (syminfo.type == "forex" ? 10 : 1)
    pips = priceRange / pipValue
    str.tostring(pips, '#.#')

// Variables para rastrear el inicio de cada sesión
var int tokyoSessionStart = na
var int londonSessionStart = na
var int nySessionStart = na

// Arrays para almacenar múltiples sesiones
var array<box> tokyoBoxes = array.new<box>()
var array<label> tokyoLabels = array.new<label>()
var array<box> londonBoxes = array.new<box>()
var array<label> londonLabels = array.new<label>()
var array<box> nyBoxes = array.new<box>()
var array<label> nyLabels = array.new<label>()

// Variables para las cajas de sesión actual
var box tokyoBox = na
var label tokyoLabel = na
var box londonBox = na
var label londonLabel = na
var box nyBox = na
var label nyLabel = na

// Detectar si estamos en cada sesión
inTokyo = showSessions and enableTokyo and inSession(tokyoStart, tokyoEnd)
inLondon = showSessions and enableLondon and inSession(londonStart, londonEnd)
inNY = showSessions and enableNY and inSession(nyStart, nyEnd)

// SESIÓN DE TOKYO
if inTokyo
    if na(tokyoSessionStart) or not inTokyo[1]
        tokyoSessionStart := time
        
        // Crear nueva sesión con color del borde basado en el bgcolor
        tokyoBorderColor = color.new(color.rgb(color.r(tokyoColor), color.g(tokyoColor), color.b(tokyoColor)), 0)
        tokyoTextColor = color.new(color.rgb(color.r(tokyoColor), color.g(tokyoColor), color.b(tokyoColor)), 0)
        
        tokyoBox := box.new(time, high, time, low, xloc=xloc.bar_time, bgcolor=tokyoColor, border_color=tokyoBorderColor, border_width=1, border_style=line.style_dashed)
        tokyoLabel := label.new(time, high, 'Tokyo', xloc=xloc.bar_time, yloc=yloc.price, color=color.new(tokyoColor, 100), textcolor=tokyoTextColor, style=label.style_none, size=size.small)
        
        // Agregar a arrays
        array.push(tokyoBoxes, tokyoBox)
        array.push(tokyoLabels, tokyoLabel)
        
        // Eliminar sesiones antiguas si exceden el límite
        if array.size(tokyoBoxes) > maxSessionsToShow
            box.delete(array.shift(tokyoBoxes))
            label.delete(array.shift(tokyoLabels))
    else
        if not na(tokyoBox)
            box.set_right(tokyoBox, time)
            box.set_top(tokyoBox, math.max(box.get_top(tokyoBox), high))
            box.set_bottom(tokyoBox, math.min(box.get_bottom(tokyoBox), low))
            
            // Calcular y mostrar pips
            sessionRange = box.get_top(tokyoBox) - box.get_bottom(tokyoBox)
            pipsText = 'Tokyo (' + calcPips(sessionRange) + ' pips)'
            
            label.set_x(tokyoLabel, int((tokyoSessionStart + time) / 2))
            label.set_y(tokyoLabel, box.get_top(tokyoBox))
            label.set_text(tokyoLabel, pipsText)
else
    if not na(tokyoSessionStart) and inTokyo[1]
        tokyoSessionStart := na

// SESIÓN DE LONDON
if inLondon
    if na(londonSessionStart) or not inLondon[1]
        londonSessionStart := time
        
        // Crear nueva sesión con color del borde basado en el bgcolor
        londonBorderColor = color.new(color.rgb(color.r(londonColor), color.g(londonColor), color.b(londonColor)), 0)
        londonTextColor = color.new(color.rgb(color.r(londonColor), color.g(londonColor), color.b(londonColor)), 0)
        
        londonBox := box.new(time, high, time, low, xloc=xloc.bar_time, bgcolor=londonColor, border_color=londonBorderColor, border_width=1, border_style=line.style_dashed)
        londonLabel := label.new(time, high, 'London', xloc=xloc.bar_time, yloc=yloc.price, color=color.new(londonColor, 100), textcolor=londonTextColor, style=label.style_none, size=size.small)
        
        // Agregar a arrays
        array.push(londonBoxes, londonBox)
        array.push(londonLabels, londonLabel)
        
        // Eliminar sesiones antiguas si exceden el límite
        if array.size(londonBoxes) > maxSessionsToShow
            box.delete(array.shift(londonBoxes))
            label.delete(array.shift(londonLabels))
    else
        if not na(londonBox)
            box.set_right(londonBox, time)
            box.set_top(londonBox, math.max(box.get_top(londonBox), high))
            box.set_bottom(londonBox, math.min(box.get_bottom(londonBox), low))
            
            // Calcular y mostrar pips
            sessionRange = box.get_top(londonBox) - box.get_bottom(londonBox)
            pipsText = 'London (' + calcPips(sessionRange) + ' pips)'
            
            label.set_x(londonLabel, int((londonSessionStart + time) / 2))
            label.set_y(londonLabel, box.get_top(londonBox))
            label.set_text(londonLabel, pipsText)
else
    if not na(londonSessionStart) and inLondon[1]
        londonSessionStart := na

// SESIÓN DE NEW YORK
if inNY
    if na(nySessionStart) or not inNY[1]
        nySessionStart := time
        
        // Crear nueva sesión con color del borde basado en el bgcolor
        nyBorderColor = color.new(color.rgb(color.r(nyColor), color.g(nyColor), color.b(nyColor)), 0)
        nyTextColor = color.new(color.rgb(color.r(nyColor), color.g(nyColor), color.b(nyColor)), 0)
        
        nyBox := box.new(time, high, time, low, xloc=xloc.bar_time, bgcolor=nyColor, border_color=nyBorderColor, border_width=1, border_style=line.style_dashed)
        nyLabel := label.new(time, high, 'New York', xloc=xloc.bar_time, yloc=yloc.price, color=color.new(nyColor, 100), textcolor=nyTextColor, style=label.style_none, size=size.small)
        
        // Agregar a arrays
        array.push(nyBoxes, nyBox)
        array.push(nyLabels, nyLabel)
        
        // Eliminar sesiones antiguas si exceden el límite
        if array.size(nyBoxes) > maxSessionsToShow
            box.delete(array.shift(nyBoxes))
            label.delete(array.shift(nyLabels))
    else
        if not na(nyBox)
            box.set_right(nyBox, time)
            box.set_top(nyBox, math.max(box.get_top(nyBox), high))
            box.set_bottom(nyBox, math.min(box.get_bottom(nyBox), low))
            
            // Calcular y mostrar pips
            sessionRange = box.get_top(nyBox) - box.get_bottom(nyBox)
            pipsText = 'New York (' + calcPips(sessionRange) + ' pips)'
            
            label.set_x(nyLabel, int((nySessionStart + time) / 2))
            label.set_y(nyLabel, box.get_top(nyBox))
            label.set_text(nyLabel, pipsText)
else
    if not na(nySessionStart) and inNY[1]
        nySessionStart := na
// ============================================
// SESSION SWEEP + I.CHoCH SIGNALS
// ============================================

enableSessionSweepSignals = input.bool(true, 'Enable Session Sweep Signals', group='Session Sweep Signals')
sessionSweepLookback = input.int(10, 'Session Sweep Lookback', minval=3, maxval=50, group='Session Sweep Signals', tooltip='Lookback period for detecting sweeps')
maxBarsAfterSession = input.int(100, 'Max Bars After Session Close', minval=10, maxval=200, group='Session Sweep Signals', tooltip='Maximum bars to look for sweeps after session closes')
sessionSweepBuyColor = input.color(#00ff88, 'Buy Signal Color', group='Session Sweep Signals')
sessionSweepSellColor = input.color(#ff0044, 'Sell Signal Color', group='Session Sweep Signals')
sessionLabelTransparency = input(0, 'Session Labels Transparency', group='Session Sweep Signals')
sessionLabelSize = input.int(2, 'Session Label Size', minval=1, maxval=5, group='Session Sweep Signals')

// Convertir tamaño de label
sessionLabelSizeValue = switch sessionLabelSize
    1 => size.tiny
    2 => size.small
    3 => size.normal
    4 => size.large
    5 => size.huge

// Tipo para almacenar información de sesiones cerradas
type ClosedSession
    string name
    float high
    float low
    int closeBar
    bool lowSwept = false
    bool highSwept = false
    int lowSweepBar = na
    int highSweepBar = na
    bool buySignalSent = false
    bool sellSignalSent = false

var array<ClosedSession> closedSessions = array.new<ClosedSession>()

// Registrar sesiones cuando cierran
if showSessions
    // Tokyo cierra
    if inTokyo[1] and not inTokyo and not na(tokyoBox)
        sessionHigh = box.get_top(tokyoBox)
        sessionLow = box.get_bottom(tokyoBox)
        newSession = ClosedSession.new("Tokyo", sessionHigh, sessionLow, bar_index)
        closedSessions.push(newSession)
        
        // Mantener solo últimas 20 sesiones
        if closedSessions.size() > 20
            closedSessions.shift()
    
    // London cierra
    if inLondon[1] and not inLondon and not na(londonBox)
        sessionHigh = box.get_top(londonBox)
        sessionLow = box.get_bottom(londonBox)
        newSession = ClosedSession.new("London", sessionHigh, sessionLow, bar_index)
        closedSessions.push(newSession)
        
        if closedSessions.size() > 20
            closedSessions.shift()
    
    // New York cierra
    if inNY[1] and not inNY and not na(nyBox)
        sessionHigh = box.get_top(nyBox)
        sessionLow = box.get_bottom(nyBox)
        newSession = ClosedSession.new("New York", sessionHigh, sessionLow, bar_index)
        closedSessions.push(newSession)
        
        if closedSessions.size() > 20
            closedSessions.shift()

// Detectar sweeps y generar señales con I.CHoCH
if enableSessionSweepSignals and closedSessions.size() > 0
    for i = closedSessions.size() - 1 to 0
        sess = closedSessions.get(i)
        
        // Solo procesar sesiones dentro del rango de barras
        barsAfterClose = bar_index - sess.closeBar
        if barsAfterClose > 0 and barsAfterClose <= maxBarsAfterSession
            
            // ===== DETECTAR SWEEP AL LOW (similar a liquidity sweep) =====
            if not sess.lowSwept
                localLow = ta.lowest(low, sessionSweepLookback)
                
                // Sweep: mecha penetra el low de la sesión pero cierra arriba
                bullishPenetration = low < sess.low and not na(sess.low)
                bullishRejection = close > sess.low
                bullishLocalConfirm = low == localLow
                
                if bullishPenetration and bullishRejection and bullishLocalConfirm
                    sess.lowSwept := true
                    sess.lowSweepBar := bar_index
            
            // Si ya hubo sweep al low, esperar I.CHoCH alcista
            if sess.lowSwept and not sess.buySignalSent
                // Verificar que el I.CHoCH ocurra DESPUÉS del sweep
                if not na(sess.lowSweepBar) and bar_index > sess.lowSweepBar
                    // Detectar I.CHoCH alcista (cambio de estructura interna a alcista)
                    if iTrend == 1 and iTrend[1] != 1
                        // Generar señal de COMPRA
                        label.new(bar_index, low, 
                                 'COMPRA',
                                 xloc.bar_index, 
                                 yloc.price,
                                 color.new(sessionSweepBuyColor, sessionLabelTransparency),
                                 label.style_label_up,
                                 color.new(color.black, sessionLabelTransparency),
                                 sessionLabelSizeValue)
                        
                        sess.buySignalSent := true
                        alert('SESSION SWEEP COMPRA - ' + sess.name + ' Low swept + I.CHoCH!', alert.freq_once_per_bar)
            
            // ===== DETECTAR SWEEP AL HIGH (similar a liquidity sweep) =====
            if not sess.highSwept
                localHigh = ta.highest(high, sessionSweepLookback)
                
                // Sweep: mecha penetra el high de la sesión pero cierra abajo
                bearishPenetration = high > sess.high and not na(sess.high)
                bearishRejection = close < sess.high
                bearishLocalConfirm = high == localHigh
                
                if bearishPenetration and bearishRejection and bearishLocalConfirm
                    sess.highSwept := true
                    sess.highSweepBar := bar_index
            
            // Si ya hubo sweep al high, esperar I.CHoCH bajista
            if sess.highSwept and not sess.sellSignalSent
                // Verificar que el I.CHoCH ocurra DESPUÉS del sweep
                if not na(sess.highSweepBar) and bar_index > sess.highSweepBar
                    // Detectar I.CHoCH bajista (cambio de estructura interna a bajista)
                    if iTrend == -1 and iTrend[1] != -1
                        // Generar señal de VENTA
                        label.new(bar_index, high, 
                                 'VENTA',
                                 xloc.bar_index, 
                                 yloc.price,
                                 color.new(sessionSweepSellColor, sessionLabelTransparency),
                                 label.style_label_down,
                                 color.new(color.black, sessionLabelTransparency),
                                 sessionLabelSizeValue)
                        
                        sess.sellSignalSent := true
                        alert('SESSION SWEEP VENTA - ' + sess.name + ' High swept + I.CHoCH!', alert.freq_once_per_bar)
        
        else if barsAfterClose > maxBarsAfterSession
            // Eliminar sesiones expiradas
            closedSessions.remove(i)

// ============================================
// ALERTCONDITIONS PARA SESSION SWEEP
// ============================================

// Variables para detectar señales en la barra actual
var bool sessionBuySignalThisBar = false
var bool sessionSellSignalThisBar = false

// Resetear SOLO si es una nueva barra
if barstate.isnew
    sessionBuySignalThisBar := false
    sessionSellSignalThisBar := false

// Detectar si hubo señal en esta barra (SIN modificar el estado de las sesiones)
if enableSessionSweepSignals and closedSessions.size() > 0
    for i = closedSessions.size() - 1 to 0
        sess = closedSessions.get(i)
        barsAfterClose = bar_index - sess.closeBar
        
        if barsAfterClose > 0 and barsAfterClose <= maxBarsAfterSession
            // Detectar señal de COMPRA (sin marcar como enviada)
            if sess.lowSwept and not sess.buySignalSent and not na(sess.lowSweepBar) and bar_index > sess.lowSweepBar
                if iTrend == 1 and iTrend[1] != 1
                    sessionBuySignalThisBar := true
            
            // Detectar señal de VENTA (sin marcar como enviada)
            if sess.highSwept and not sess.sellSignalSent and not na(sess.highSweepBar) and bar_index > sess.highSweepBar
                if iTrend == -1 and iTrend[1] != -1
                    sessionSellSignalThisBar := true

// Crear alertconditions configurables
alertcondition(sessionBuySignalThisBar, title='Session Sweep - COMPRA', message='SESSION COMPRA')
alertcondition(sessionSellSignalThisBar, title='Session Sweep - VENTA', message='SESSION SWEEP VENTA')
alertcondition(sessionBuySignalThisBar or sessionSellSignalThisBar, title='Session Sweep - Cualquier Señal', message='SESSION SWEEP - Nueva señal detectada')

// ============================================
// MULTI-TIMEFRAME BIAS DASHBOARD
// ============================================

showMTFBias = input.bool(true, 'Show Multi-Timeframe Bias', group='MTF Bias Dashboard')
mtfDashboardPosition = input.string('Top Right', 'MTF Dashboard Position', 
     options=['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right'], group='MTF Bias Dashboard')

// Función para obtener la posición de la tabla
getMTFTablePosition(pos) =>
    switch pos
        'Top Left' => position.top_left
        'Top Right' => position.top_right
        'Bottom Left' => position.bottom_left
        'Bottom Right' => position.bottom_right

// Función para determinar el bias de una temporalidad (CORREGIDA)
getBias(tf) =>
    [extStructure, intStructure] = request.security(syminfo.tickerid, tf, 
         [marketStructure, iMarketStructure], 
         lookahead=barmerge.lookahead_off)
    
    // PRIORIDAD: Estructura Externa (estructura principal)
    // Si external es bullish -> UP
    // Si external es bearish -> DOWN
    // Si external es neutral, usar internal como backup
    bias = extStructure == "bullish" ? "UP" : 
           extStructure == "bearish" ? "DOWN" : 
           intStructure == "bullish" ? "UP" : 
           intStructure == "bearish" ? "DOWN" : 
           "DOWN"  // Por defecto DOWN si no hay datos claros
    
    bias

// Crear tabla: 9 columnas (Bias + 8 temporalidades), 2 filas
var table mtfBiasTable = table.new(getMTFTablePosition(mtfDashboardPosition), 9, 2, 
     bgcolor=color.new(#1a1a1a, 5), 
     frame_color=color.new(#404040, 70), 
     frame_width=1,
     border_color=color.new(#404040, 50),
     border_width=1)

if showMTFBias and barstate.islast
    // ===== FILA 0: HEADERS =====
    table.cell(mtfBiasTable, 0, 0, 'Bias', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 1, 0, '1M', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 2, 0, '5M', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 3, 0, '15M', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 4, 0, '30M', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 5, 0, '1H', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 6, 0, '4H', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 7, 0, '1D', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    table.cell(mtfBiasTable, 8, 0, '1W', 
         text_color=color.new(#ffffff, 0), 
         bgcolor=color.new(#2a2a2a, 0),
         text_size=size.small)
    
    // ===== FILA 1: BIAS DE CADA TEMPORALIDAD CON TRIÁNGULOS =====
    
    // 1 minuto
    bias1m = getBias("1")
    symbol1m = bias1m == "UP" ? "▲" : "▼"
    color1m = bias1m == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 1, 1, symbol1m, 
         text_color=color1m, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)
    
    // 5 minutos
    bias5m = getBias("5")
    symbol5m = bias5m == "UP" ? "▲" : "▼"
    color5m = bias5m == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 2, 1, symbol5m, 
         text_color=color5m, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)
    
    // 15 minutos
    bias15m = getBias("15")
    symbol15m = bias15m == "UP" ? "▲" : "▼"
    color15m = bias15m == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 3, 1, symbol15m, 
         text_color=color15m, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)
    
    // 30 minutos
    bias30m = getBias("30")
    symbol30m = bias30m == "UP" ? "▲" : "▼"
    color30m = bias30m == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 4, 1, symbol30m, 
         text_color=color30m, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)
    
    // 1 hora
    bias1h = getBias("60")
    symbol1h = bias1h == "UP" ? "▲" : "▼"
    color1h = bias1h == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 5, 1, symbol1h, 
         text_color=color1h, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)
    
    // 4 horas
    bias4h = getBias("240")
    symbol4h = bias4h == "UP" ? "▲" : "▼"
    color4h = bias4h == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 6, 1, symbol4h, 
         text_color=color4h, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)
    
    // Diario
    biasD = getBias("D")
    symbolD = biasD == "UP" ? "▲" : "▼"
    colorD = biasD == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 7, 1, symbolD, 
         text_color=colorD, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)
    
    // Semanal
    biasW = getBias("W")
    symbolW = biasW == "UP" ? "▲" : "▼"
    colorW = biasW == "UP" ? color.new(#00ff00, 0) : color.new(#ff0000, 0)
    
    table.cell(mtfBiasTable, 8, 1, symbolW, 
         text_color=colorW, 
         bgcolor=color.new(#1a1a1a, 0),
         text_size=size.normal)


// ============================================
// CURRENT STRUCTURE DISPLAY
// ============================================

showCurrentStructure = input.bool(true, 'Show Current Structure', group='Current Structure')
structureTablePosition = input.string('Bottom Right', 'Table Position', options=['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right'], group='Current Structure')

getTablePosition(pos) =>
    switch pos
        'Top Left' => position.top_left
        'Top Right' => position.top_right
        'Bottom Left' => position.bottom_left
        'Bottom Right' => position.bottom_right

var table structureTable = table.new(getTablePosition(structureTablePosition), 2, 3, 
     bgcolor=color.new(#1a1a1a, 10), 
     frame_color=color.new(#404040, 50), 
     frame_width=1,
     border_color=color.new(#404040, 50),
     border_width=1)

if showCurrentStructure and barstate.islast
    // Header
    table.cell(structureTable, 0, 0, 'Structure', 
         text_color=color.new(color.white, 0), 
         bgcolor=color.new(#2a2a2a, 10),
         text_size=size.normal)
    
    table.cell(structureTable, 1, 0, 'Status', 
         text_color=color.new(color.white, 0), 
         bgcolor=color.new(#2a2a2a, 10),
         text_size=size.normal)
    
    // External Structure
    extStructureText = trendDirection == 1 ? "BULLISH" : trendDirection == -1 ? "BEARISH" : "NEUTRAL"
    extStructureColor = trendDirection == 1 ? color.new(#03ff85, 0) : trendDirection == -1 ? color.new(#fc0808, 0) : color.new(color.gray, 0)
    
    table.cell(structureTable, 0, 1, 'External', 
         text_color=color.new(color.white, 20), 
         bgcolor=color.new(#1a1a1a, 10),
         text_size=size.normal)
    
    table.cell(structureTable, 1, 1, extStructureText, 
         text_color=extStructureColor, 
         bgcolor=color.new(#1a1a1a, 10),
         text_size=size.normal)
    
    // Internal Structure
    intStructureText = iTrend == 1 ? "BULLISH" : iTrend == -1 ? "BEARISH" : "NEUTRAL"
    intStructureColor = iTrend == 1 ? color.new(#03ff85, 0) : iTrend == -1 ? color.new(#fc0808, 0) : color.new(color.gray, 0)
    
    table.cell(structureTable, 0, 2, 'Internal', 
         text_color=color.new(color.white, 20), 
         bgcolor=color.new(#1a1a1a, 10),
         text_size=size.normal)
    
    table.cell(structureTable, 1, 2, intStructureText, 
         text_color=intStructureColor, 
         bgcolor=color.new(#1a1a1a, 10),
         text_size=size.normal)

// ============================================
// PART 9: SETUP CHECKLIST
// ============================================
// Panel de confluencias estilo checklist institucional.
// Definiciones asumidas (ajustables por el usuario):
// - Liquidity Sweep: barrido confirmado (Part 5) alineado con la direccion de la
//   estructura externa (sweep alcista si trend=bullish, bajista si trend=bearish).
// - HTF PDA Delivery: precio tocando actualmente un Order Block o FVG no mitigado
//   que coincide con la direccion de la estructura externa.
// - MSS Confirmed: shift de estructura interna (iTrend) reciente y alineado con
//   la estructura externa actual.
// - Macro Window: horarios "macro" ICT estandar (hora del grafico).
// - Equilibrium: precio del lado correcto del 50% del rango de estructura externa
//   (discount si bullish, premium si bearish), con tolerancia configurable.
// - Volume Influx: volumen actual >= promedio(20) * multiplicador.
// - Clear Targets: criterio discrecional, checkbox manual.

showSetupChecklist = input.bool(true, 'Show Setup Checklist', group='Setup Checklist')
checklistPosition = input.string('Bottom Right', 'Table Position', options=['Top Left', 'Top Right', 'Bottom Left', 'Bottom Right'], group='Setup Checklist')
checklistLookback = input.int(30, 'Recency Window (bars)', minval=1, maxval=200, group='Setup Checklist', tooltip='Cuantas barras hacia atras se considera "reciente" para Sweep, MSS y HTF PDA Delivery')
volumeMultiplier = input.float(1.2, 'Volume Influx Multiplier', minval=1.0, step=0.1, group='Setup Checklist', tooltip='Volumen actual vs promedio(20) para considerar Volume Influx')
equilibriumTolerancePct = input.float(2.0, 'Equilibrium Tolerance %', minval=0, maxval=50, group='Setup Checklist', tooltip='Margen adicional alrededor del equilibrium (50%) del rango')
useMacroWindows = input.bool(true, 'Enable ICT Macro Windows', group='Setup Checklist')
manualClearTargets = input.bool(true, 'Clear Targets (manual)', group='Setup Checklist', tooltip='Criterio discrecional: marcalo vos segun si el camino al objetivo esta libre')

// ----- Helper: FVG activa (no mitigada) en el precio actual -----
inActiveFVG(bool wantBullish) =>
    bool found = false
    if array.size(fvgBoxes) > 0
        for i = 0 to array.size(fvgBoxes) - 1
            if array.get(fvgTypes, i) == wantBullish and not array.get(isFvgMitigated, i)
                b = array.get(fvgBoxes, i)
                if low <= box.get_top(b) and high >= box.get_bottom(b)
                    found := true
    found

// ----- Helper: fila de la tabla checklist -----
addChecklistRow(table tbl, int row, string lbl, bool passed) =>
    icon = passed ? '✅' : '❌'
    iconColor = passed ? color.new(#03ff85, 0) : color.new(#fc0808, 0)
    table.cell(tbl, 0, row, lbl, text_color=color.new(color.white, 10), bgcolor=color.new(#1a1a1a, 10), text_size=size.small, text_halign=text.align_left)
    table.cell(tbl, 1, row, icon, text_color=iconColor, bgcolor=color.new(#1a1a1a, 10), text_size=size.small, text_halign=text.align_center)

// ----- 1. Liquidity Sweep (alineado con la estructura externa) -----
sweepAlignedNow = (trendDirection == 1 and bullishSweepConfirmed) or (trendDirection == -1 and bearishSweepConfirmed)
var int lastAlignedSweepBar = na
if sweepAlignedNow
    lastAlignedSweepBar := bar_index
liquiditySweepOK = not na(lastAlignedSweepBar) and (bar_index - lastAlignedSweepBar) <= checklistLookback

// ----- 2. HTF PDA Delivery (OB o FVG activa en la direccion del trend) -----
[chkBullOBIdx, chkBullOBTop, chkBullOBBottom] = getPriceInOB("Bull")
[chkBearOBIdx, chkBearOBTop, chkBearOBBottom] = getPriceInOB("Bear")
pdaTouchNow = (trendDirection == 1 and (chkBullOBIdx >= 0 or inActiveFVG(true))) or (trendDirection == -1 and (chkBearOBIdx >= 0 or inActiveFVG(false)))
var int lastPDABar = na
if pdaTouchNow
    lastPDABar := bar_index
htfPdaDelivery = not na(lastPDABar) and (bar_index - lastPDABar) <= checklistLookback

// ----- 3. MSS Confirmed (shift de estructura interna reciente y alineado) -----
mssEventNow = iTrend != iTrend[1] and iTrend != 0
var int lastMSSBar = na
if mssEventNow
    lastMSSBar := bar_index
mssConfirmed = not na(lastMSSBar) and (bar_index - lastMSSBar) <= checklistLookback and iTrend == trendDirection and trendDirection != 0

// ----- 4. Macro Window (horarios ICT estandar, hora del grafico) -----
inMacroWindow = useMacroWindows and (
     inSession('02:33', '03:00') or
     inSession('04:03', '04:30') or
     inSession('08:50', '09:10') or
     inSession('09:50', '10:10') or
     inSession('10:50', '11:10') or
     inSession('11:50', '12:10') or
     inSession('13:10', '13:40') or
     inSession('15:15', '15:45'))

// ----- 5. Equilibrium (lado correcto del 50% del rango externo) -----
equilibriumLevel = (lastSwingHigh + lastSwingLow) / 2
equilibriumRange = lastSwingHigh - lastSwingLow
equilibriumTolerance = equilibriumRange * (equilibriumTolerancePct / 100)
equilibriumOK = not na(equilibriumLevel) and (
     trendDirection == 1 ? close <= equilibriumLevel + equilibriumTolerance :
     trendDirection == -1 ? close >= equilibriumLevel - equilibriumTolerance :
     false)

// ----- 6. Volume Influx -----
avgVolume20 = ta.sma(volume, 20)
volumeInfluxOK = volume >= avgVolume20 * volumeMultiplier

// ----- 7. Clear Targets (manual) -----
clearTargetsOK = manualClearTargets

// ----- Render tabla -----
var table checklistTable = table.new(getTablePosition(checklistPosition), 2, 8,
     bgcolor=color.new(#1a1a1a, 5),
     frame_color=color.new(#404040, 70),
     frame_width=1,
     border_color=color.new(#404040, 50),
     border_width=1)

if showSetupChecklist and barstate.islast
    table.cell(checklistTable, 0, 0, 'SETUP CHECKLIST', text_color=color.new(color.white, 0), bgcolor=color.new(#2a2a2a, 0), text_size=size.small)
    table.cell(checklistTable, 1, 0, '', text_color=color.new(color.white, 0), bgcolor=color.new(#2a2a2a, 0), text_size=size.small)
    table.merge_cells(checklistTable, 0, 0, 1, 0)

    addChecklistRow(checklistTable, 1, 'Liquidity Sweep', liquiditySweepOK)
    addChecklistRow(checklistTable, 2, 'HTF PDA Delivery', htfPdaDelivery)
    addChecklistRow(checklistTable, 3, 'MSS Confirmed', mssConfirmed)
    addChecklistRow(checklistTable, 4, 'Macro Window', inMacroWindow)
    addChecklistRow(checklistTable, 5, 'Equilibrium', equilibriumOK)
    addChecklistRow(checklistTable, 6, 'Volume Influx', volumeInfluxOK)
    addChecklistRow(checklistTable, 7, 'Clear Targets', clearTargetsOK)

// ============================================
// PART 10: MULTI-TIMEFRAME STRUCTURE (CHOCH & BOS)
// ============================================
// Traído del script viejo "TRADING INSTITUCIONAL [PRIVADO] FINAL".
// Permite marcar quiebres de estructura (BOS/CHOCH) de hasta 3 temporalidades
// distintas y verlos dibujados sobre el timeframe actual del grafico.
// Es un sistema independiente del de Part 2 (estructura externa/interna
// single-timeframe) -- ambos conviven sin pisarse.

// Constants
Transparent_Color = color.new(color.white, 100)

// Groups for CHOCH & BOS
General_Settings_group = "-------CHOCH & BOS General Settings-------"
Timeframe_1_Group  = "-------CHOCH & BOS Timeframe 1 Settings--------"
Timeframe_2_Group  = "-------CHOCH & BOS Timeframe 2 Settings--------"
Timeframe_3_Group  = "-------CHOCH & BOS Timeframe 3 Settings--------"

// Tooltips
Hide_MS_Tooltip = "If true will hide all MS plots such as \"HH 2H\" or \"HH 15min\""
Hide_Breaks_Tooltip = "If true will hide all MS breaks such as \"BOS 1H\" or \"MSS 15min\""
Timeframe_Tooltip = "If set to chart is true no need to alter these two inputs."
Set_To_Chart_Tooltip = "If set to chart is set to true, there is no need to alter the Timeframe inputs, it will automatically configure itself to the charts timeframe."
Lower_Timeframe_Tooltip = "If set to true and chart timeframe is higher than the choosen timeframe, structure will not display. Note plotting ltf structure on a htf will provide inaccurate plots."
Use_High_Low_Tooltip = "If set to true high and low values will be used to confirm market structure else if set to false close will be used."
Display_TF_Pivots = "If true the script will display the timeframe declared in the TF inputs"
Display_TF_MS = "If true the script will display the timeframe's market structure declared in the TF inputs if Hide all Market Structure is false in general settings."
BOS_Alert_Tooltip = "Set to true to activate BOS alerts then proceed to set the any alert function specifically on this script."
MSS_Alert_Tooltip = "Set to true to activate MSS alerts then proceed to set the any alert function specifically on this script."
BOS_Plot_Tooltip = "If set to true the TF BOS plots will be plotted else if false they will be hidden."
MSS_Plot_Tooltip = "If set to true the TF MSS plots will be plotted else if false they will be hidden."

// General Settings
Hide_All_MS = input.bool(defval = true, title = "Hide all Market Structure", group = General_Settings_group, tooltip = Hide_MS_Tooltip)
Hide_All_Breaks = input.bool(defval = false, title = "Hide all Structure Breaks", group = General_Settings_group, tooltip = Hide_Breaks_Tooltip)
Show_Only_On_Lower_Timeframes = input.bool(defval = true, title = "Show Structure only on a lower Timeframe", group = General_Settings_group, tooltip = Lower_Timeframe_Tooltip)

// Timeframe 1 Settings
TF_1_Use_Bos_Plot = input.bool(defval = true, title = "Show TF 1 BOS Plots", group = Timeframe_1_Group, tooltip = BOS_Plot_Tooltip)
TF_1_Use_MSS_Plot = input.bool(defval = true, title = "Show TF 1 MSS Plots", group = Timeframe_1_Group, tooltip = MSS_Plot_Tooltip)
