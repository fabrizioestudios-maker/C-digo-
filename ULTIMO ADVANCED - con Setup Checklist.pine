//@version=6
// © Fabrizio Dalleva & Jessica Dubon
// ============================================
// CREDITS & CONCEPTUAL FRAMEWORK
// ============================================
// This indicator is based on institutional trading concepts from:
// - ICT (Inner Circle Trader): Smart Money methodology, liquidity concepts
// - Order Flow Analysis: Supply/demand imbalance detection
// - Market Structure: Break of structure and change of character principles
//
// While these concepts are public domain knowledge in trading education,
// the specific implementation approach was inspired by work shared by
// community authors including algoryze (sweep detection patterns), UAlgo (EQH logic) and // fluxchart (order block visualization techniques).
//
// CODE IMPLEMENTATION:
// All code has been written from scratch without copying external libraries.
// The logic, algorithms, and integration are original work.
//
// ============================================


indicator("Advanced Institutional Trading Indicator", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// ============================================
// HELPER FUNCTIONS
// ============================================

deleteLine(line _line, label _label) =>
    line.delete(_line)
    if not na(_label)
        label.delete(_label)

getLineStyle(lineOption) =>
    lineOption == "─" ? line.style_solid : lineOption == "┄" ? line.style_dotted : line.style_dashed

get_structure_highest_bar(lookback) =>
    var int idx = 0
    maxBar = bar_index > lookback ? ta.highestbars(high, lookback) : ta.highestbars(high, bar_index + 1)
    for i = 0 to lookback - 1 by 1
        if high[i+1] > high[i+2] and high[i] <= high[i+1] and ((i+1) * -1) >= maxBar
            idx := (i+1) * -1
    idx := idx == 0 ? maxBar : idx 

get_structure_lowest_bar(lookback) =>
    var int idx = 0
    minBar = bar_index > lookback ? ta.lowestbars(low, lookback) : ta.lowestbars(low, bar_index + 1)
    for i = 0 to lookback - 1 by 1
        if low[i+1] < low[i+2] and low[i] >= low[i+1] and ((i+1) * -1) >= minBar
            idx := (i+1) * -1
    idx := idx == 0 ? minBar : idx 

// ============================================
// PART 1: FAIR VALUE GAPS (FVG)
// ============================================

isFvgToShow = input(true, title='Display FVG', group="Fair Value Gap")
bullishFvgColor = input(color.new(color.green, 50), 'Bullish FVG Color', group="Fair Value Gap")
bearishFvgColor = input(color.new(color.red, 50), 'Bearish FVG Color', group="Fair Value Gap")
mitigatedFvgColor = input(color.new(color.gray, 50), 'Mitigated FVG Color', group="Fair Value Gap")
fvgHistoryNbr = input.int(5, 'Number of FVG to show', minval=1, maxval=50, group="Fair Value Gap")
isMitigatedFvgToReduce = input(false, title='Reduce mitigated FVG', group="Fair Value Gap")

var array<box> fvgBoxes = array.new_box(0)
var array<bool> fvgTypes = array.new_bool(0)
var array<label> fvgLabels = array.new_label(0)
var array<bool> isFvgMitigated = array.new_bool(0)

FVGDraw(_boxes, _fvgTypes, _isFvgMitigated, _fvgLabels) => 
    for [index, value] in _boxes
        if array.get(_fvgTypes, index)
            if low <= box.get_bottom(value)
                array.remove(_boxes, index)
                array.remove(_fvgTypes, index)
                array.remove(_isFvgMitigated, index)
                label.delete(array.get(_fvgLabels, index))
                array.remove(_fvgLabels, index)
                box.delete(value)
            else 
                if low < box.get_top(value)
                    box.set_bgcolor(value, mitigatedFvgColor)
                    if not array.get(_isFvgMitigated, index)
                        alert("FVG has been mitigated", alert.freq_once_per_bar)
                        array.set(_isFvgMitigated, index, true)
                    if isMitigatedFvgToReduce
                        box.set_top(value, low)
                box.set_right(value, bar_index)
                labelX = int((box.get_left(value) + box.get_right(value)) / 2)
                labelY = (box.get_top(value) + box.get_bottom(value)) / 2
                label.set_x(array.get(_fvgLabels, index), labelX)
                label.set_y(array.get(_fvgLabels, index), labelY)
        else
            if high >= box.get_top(value)
                array.remove(_boxes, index)
                array.remove(_fvgTypes, index)
                array.remove(_isFvgMitigated, index)
                label.delete(array.get(_fvgLabels, index))
                array.remove(_fvgLabels, index)
                box.delete(value)
            else
                if high > box.get_bottom(value)
                    box.set_bgcolor(value, mitigatedFvgColor)
                    if not array.get(_isFvgMitigated, index)
                        alert("FVG has been mitigated", alert.freq_once_per_bar)
                        array.set(_isFvgMitigated, index, true)
                    if isMitigatedFvgToReduce
                        box.set_bottom(value, high)
                box.set_right(value, bar_index)
                labelX = int((box.get_left(value) + box.get_right(value)) / 2)
                labelY = (box.get_top(value) + box.get_bottom(value)) / 2
                label.set_x(array.get(_fvgLabels, index), labelX)
                label.set_y(array.get(_fvgLabels, index), labelY)

isBullishFVG = high[3] < low[1]
isBearishFVG = low[3] > high[1]

if isBullishFVG and isFvgToShow
    box _box = box.new(left=bar_index - 2, top=low[1], right=bar_index[1], bottom=high[3], border_style=line.style_solid, border_width=1, bgcolor=bullishFvgColor, border_color=color.new(color.green, 100))
    labelX = int((bar_index - 2 + bar_index[1]) / 2)
    labelY = (low[1] + high[3]) / 2
    label _label = label.new(labelX, labelY, text="", style=label.style_none, textcolor=color.white)
    array.push(fvgBoxes, _box)
    array.push(fvgTypes, true)
    array.push(isFvgMitigated, false)
    array.push(fvgLabels, _label)
    if array.size(fvgBoxes) > fvgHistoryNbr + 1
        box.delete(array.get(fvgBoxes, 0))
        label.delete(array.get(fvgLabels, 0))
        array.remove(fvgLabels, 0)
        array.remove(fvgBoxes, 0)
        array.remove(fvgTypes, 0)
        array.remove(isFvgMitigated, 0)

if isBearishFVG and isFvgToShow
    box _box = box.new(left=bar_index - 2, top=low[3], right=bar_index[1], bottom=high[1], border_style=line.style_solid, border_width=1, bgcolor=bearishFvgColor, border_color=color.new(color.red, 100))
    labelX = int((bar_index - 2 + bar_index[1]) / 2)
    labelY = (low[3] + high[1]) / 2
    label _label = label.new(labelX, labelY, text="", style=label.style_none, textcolor=color.white)
    array.push(fvgBoxes, _box)
    array.push(fvgTypes, false)
    array.push(isFvgMitigated, false)
    array.push(fvgLabels, _label)
    if array.size(fvgBoxes) > fvgHistoryNbr + 1
        box.delete(array.get(fvgBoxes, 0))
        label.delete(array.get(fvgLabels, 0))
        array.remove(fvgLabels, 0)
        array.remove(fvgBoxes, 0)
        array.remove(fvgTypes, 0)
        array.remove(isFvgMitigated, 0)

FVGDraw(fvgBoxes, fvgTypes, isFvgMitigated, fvgLabels)

/// ============================================
// PART 2: MARKET STRUCTURES (BOS/CHoCH) - CORREGIDO
// ============================================

// Inputs
showStructures = input.bool(true, 'Show Structures', group="Structures")
structureLookback = input.int(50, 'Structure Pivot Length', minval=3, maxval=50, group="Structures")
internalLookback = input.int(15, 'Internal Pivot Length', minval=2, maxval=25, group="Structures")
useBodyBreak = input.bool(true, 'Use Body for Break', group="Structures")

// Colores
externalStructureColor = input(color.rgb(200, 200, 200), 'External Structure Color', group="Structures")
internalStructureColor = input(color.rgb(200, 200, 200), 'Internal Structure Color', group="Structures")
maxStructures = input.int(30, 'Max Structures to Show', minval=5, maxval=100, group="Structures")

// Arrays para almacenar líneas y labels
var array<line> extLines = array.new_line(0)
var array<label> extLabels = array.new_label(0)
var array<line> intLines = array.new_line(0)
var array<label> intLabels = array.new_label(0)

// ============================================
// ESTRUCTURA EXTERNA
// ============================================

// Detectar pivotes
pivotHigh = ta.pivothigh(high, structureLookback, structureLookback)
pivotLow = ta.pivotlow(low, structureLookback, structureLookback)

// Variables para rastrear estructura externa
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var string marketStructure = "neutral"

// Variables para rastrear el último quiebre
var float lastBrokenHigh = na
var float lastBrokenLow = na

// Precio para detectar quiebre
breakPrice = useBodyBreak ? close : high
breakPriceLow = useBodyBreak ? close : low

// Actualizar swing points
if not na(pivotHigh)
    lastSwingHigh := high[structureLookback]
    lastSwingHighBar := bar_index - structureLookback

if not na(pivotLow)
    lastSwingLow := low[structureLookback]
    lastSwingLowBar := bar_index - structureLookback

// Detectar quiebres
if showStructures and not na(lastSwingHigh)
    if breakPrice > lastSwingHigh and (na(lastBrokenHigh) or lastSwingHigh != lastBrokenHigh)
        isBOS = marketStructure == "bullish"
        lbl = isBOS ? "BOS" : "CHoCH"
        
        if extLines.size() >= maxStructures
            line.delete(extLines.shift())
            label.delete(extLabels.shift())
        
        extLines.push(line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, xloc=xloc.bar_index, color=externalStructureColor, width=1, style=line.style_solid))
        extLabels.push(label.new(int((lastSwingHighBar + bar_index) / 2), lastSwingHigh, lbl, style=label.style_none, textcolor=externalStructureColor, size=size.normal))
        
        marketStructure := "bullish"
        lastBrokenHigh := lastSwingHigh

if showStructures and not na(lastSwingLow)
    if breakPriceLow < lastSwingLow and (na(lastBrokenLow) or lastSwingLow != lastBrokenLow)
        isBOS = marketStructure == "bearish"
        lbl = isBOS ? "BOS" : "CHoCH"
        
        if extLines.size() >= maxStructures
            line.delete(extLines.shift())
            label.delete(extLabels.shift())
        
        extLines.push(line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, xloc=xloc.bar_index, color=externalStructureColor, width=1, style=line.style_solid))
        extLabels.push(label.new(int((lastSwingLowBar + bar_index) / 2), lastSwingLow, lbl, style=label.style_none, textcolor=externalStructureColor, size=size.normal))
        
        marketStructure := "bearish"
        lastBrokenLow := lastSwingLow

// ============================================
// ESTRUCTURA INTERNA
// ============================================

// Detectar pivotes internos
iPivotHigh = ta.pivothigh(high, internalLookback, internalLookback)
iPivotLow = ta.pivotlow(low, internalLookback, internalLookback)

// Variables para estructura interna
var float iLastSwingHigh = na
var float iLastSwingLow = na
var int iLastSwingHighBar = na
var int iLastSwingLowBar = na
var string iMarketStructure = "neutral"

var float iLastBrokenHigh = na
var float iLastBrokenLow = na

// Variables para mostrar Internal High/Low
var line intHighLine = na
var label intHighLabel = na
var line intLowLine = na
var label intLowLabel = na

// Actualizar swing points internos
if not na(iPivotHigh)
    iLastSwingHigh := high[internalLookback]
    iLastSwingHighBar := bar_index - internalLookback

if not na(iPivotLow)
    iLastSwingLow := low[internalLookback]
    iLastSwingLowBar := bar_index - internalLookback

// Función para verificar proximidad con estructura externa
isNearExternalLevel(float price, bool isHigh) =>
    bool found = false
    tolerance = ta.atr(14) * 0.2
    
    if not na(lastBrokenHigh) and isHigh
        if math.abs(price - lastBrokenHigh) <= tolerance
            found := true
    
    if not na(lastBrokenLow) and not isHigh
        if math.abs(price - lastBrokenLow) <= tolerance
            found := true
    
    found

// Detectar quiebres internos
if showStructures and not na(iLastSwingHigh)
    if breakPrice > iLastSwingHigh and (na(iLastBrokenHigh) or iLastSwingHigh != iLastBrokenHigh)
        if not isNearExternalLevel(iLastSwingHigh, true)
            isBOS = iMarketStructure == "bullish"
            lbl = isBOS ? "I.BOS" : "I.CHoCH"
            
            if intLines.size() >= maxStructures
                line.delete(intLines.shift())
                label.delete(intLabels.shift())
            
            intLines.push(line.new(iLastSwingHighBar, iLastSwingHigh, bar_index, iLastSwingHigh, xloc=xloc.bar_index, color=internalStructureColor, width=1, style=line.style_solid))
            intLabels.push(label.new(int((iLastSwingHighBar + bar_index) / 2), iLastSwingHigh, lbl, style=label.style_none, textcolor=internalStructureColor, size=size.small))
        
        iMarketStructure := "bullish"
        iLastBrokenHigh := iLastSwingHigh

if showStructures and not na(iLastSwingLow)
    if breakPriceLow < iLastSwingLow and (na(iLastBrokenLow) or iLastSwingLow != iLastBrokenLow)
        if not isNearExternalLevel(iLastSwingLow, false)
            isBOS = iMarketStructure == "bearish"
            lbl = isBOS ? "I.BOS" : "I.CHoCH"
            
            if intLines.size() >= maxStructures
                line.delete(intLines.shift())
                label.delete(intLabels.shift())
            
            intLines.push(line.new(iLastSwingLowBar, iLastSwingLow, bar_index, iLastSwingLow, xloc=xloc.bar_index, color=internalStructureColor, width=1, style=line.style_solid))
            intLabels.push(label.new(int((iLastSwingLowBar + bar_index) / 2), iLastSwingLow, lbl, style=label.style_none, textcolor=internalStructureColor, size=size.small))
        
        iMarketStructure := "bearish"
        iLastBrokenLow := iLastSwingLow

// Mostrar líneas de Internal High/Low
if showStructures
    if not na(iLastSwingHigh) and not na(iLastSwingHighBar)
        line.delete(intHighLine)
        label.delete(intHighLabel)
        
        intHighLine := line.new(iLastSwingHighBar, iLastSwingHigh, bar_index, iLastSwingHigh, xloc=xloc.bar_index, color=internalStructureColor, width=1, style=line.style_dashed)
        intHighLabel := label.new(bar_index, iLastSwingHigh, "Internal High", style=label.style_label_left, textcolor=internalStructureColor, color=color.new(internalStructureColor, 100), size=size.small)
    
    if not na(iLastSwingLow) and not na(iLastSwingLowBar)
        line.delete(intLowLine)
        label.delete(intLowLabel)
        
        intLowLine := line.new(iLastSwingLowBar, iLastSwingLow, bar_index, iLastSwingLow, xloc=xloc.bar_index, color=internalStructureColor, width=1, style=line.style_dashed)
        intLowLabel := label.new(bar_index, iLastSwingLow, "Internal Low", style=label.style_label_left, textcolor=internalStructureColor, color=color.new(internalStructureColor, 100), size=size.small)

// Variables de tendencia para exportar
var int trendDirection = 0
var int iTrend = 0

trendDirection := marketStructure == "bullish" ? 1 : marketStructure == "bearish" ? -1 : 0
iTrend := iMarketStructure == "bullish" ? 1 : iMarketStructure == "bearish" ? -1 : 0
// ============================================
// PART 3: MTF LEVELS
// ============================================

LINE_SOLID = '⎯⎯⎯'
LINE_DASH = '----'
LINE_DOT = '····'
MTF_GROUP = 'Highs & Lows MTF'

enableDaily = input.bool(true, 'Daily', group=MTF_GROUP, inline='day')
dailyStyle = input.string(LINE_SOLID, '', group=MTF_GROUP, inline='day', options=[LINE_SOLID, LINE_DASH, LINE_DOT])
dailyColor = input.color(#969385, '', group=MTF_GROUP, inline='day')

enableWeekly = input.bool(true, 'Weekly', group=MTF_GROUP, inline='week')
weeklyStyle = input.string(LINE_SOLID, '', group=MTF_GROUP, inline='week', options=[LINE_SOLID, LINE_DASH, LINE_DOT])
weeklyColor = input.color(#969385, '', group=MTF_GROUP, inline='week')

enableMonthly = input.bool(true, 'Monthly', group=MTF_GROUP, inline='month')
monthlyStyle = input.string(LINE_SOLID, '', group=MTF_GROUP, inline='month', options=[LINE_SOLID, LINE_DASH, LINE_DOT])
monthlyColor = input.color(#969385, '', group=MTF_GROUP, inline='month')

var array<float> historicHighs = array.new<float>()
var array<float> historicLows = array.new<float>()
var array<int> historicTimes = array.new<int>()
var int startTime = time

varip int currentBar = bar_index
varip int previousBar = bar_index

atrValue = ta.atr(200)
isHighVolatility = (high - low) >= (2 * atrValue)

adjustedHigh = isHighVolatility ? low : high
adjustedLow = isHighVolatility ? high : low

convertLineStyle(string styleInput) =>
    switch styleInput
        LINE_SOLID => line.style_solid
        LINE_DASH => line.style_dashed
        LINE_DOT => line.style_dotted

isHigherTF(string tf) =>
    timeframe.in_seconds() >= timeframe.in_seconds(tf)

drawMTFLevel(string tf, bool sameAsChart, string styleInput, color lineColor) =>
    [prevHigh, prevLow, prevTime, currTime] = request.security(
         syminfo.tickerid,
         tf,
         [high[1], low[1], time[1], time],
         lookahead=barmerge.lookahead_on
     )
    float levelHigh = sameAsChart ? high : prevHigh
    float levelLow = sameAsChart ? low : prevLow
    int timeStart = sameAsChart ? time : prevTime
    int timeEnd = sameAsChart ? time : currTime
    int highBarTime = time
    int lowBarTime = time
    if not sameAsChart
        int startIdx = historicTimes.binary_search_rightmost(timeStart)
        int endIdx = historicTimes.binary_search_rightmost(timeEnd)
        array<int> periodTimes = historicTimes.slice(startIdx, endIdx)
        array<float> periodHighs = historicHighs.slice(startIdx, endIdx)
        array<float> periodLows = historicLows.slice(startIdx, endIdx)
        if periodTimes.size() > 0
            highBarTime := periodTimes.get(periodHighs.indexof(periodHighs.max()))
            lowBarTime := periodTimes.get(periodLows.indexof(periodLows.min()))
        else
            highBarTime := startTime
            lowBarTime := startTime
    
    var line highLevelLine = line.new(
         na, na, na, na,
         xloc=xloc.bar_time,
         color=lineColor,
         style=convertLineStyle(styleInput)
     )
    var line lowLevelLine = line.new(
         na, na, na, na,
         xloc=xloc.bar_time,
         color=lineColor,
         style=convertLineStyle(styleInput)
     )
    var label highLevelLabel = label.new(
         na, na,
         xloc=xloc.bar_time,
         text=str.format('P{0}H', tf),
         color=color(na),
         textcolor=lineColor,
         size=size.small,
         style=label.style_label_left
     )
    var label lowLevelLabel = label.new(
         na, na,
         xloc=xloc.bar_time,
         text=str.format('P{0}L', tf),
         color=color(na),
         textcolor=lineColor,
         size=size.small,
         style=label.style_label_left
     )
    
    var bool highTouched = false
    var bool lowTouched = false
    var float trackedLevelHigh = na
    var float trackedLevelLow = na
    var int touchBarHigh = na
    var int touchBarLow = na
    
    // Detectar cambio de nivel (nuevo período) y resetear
    bool newHighLevel = na(trackedLevelHigh) or levelHigh != trackedLevelHigh
    bool newLowLevel = na(trackedLevelLow) or levelLow != trackedLevelLow
    
    if newHighLevel
        highTouched := false
        trackedLevelHigh := levelHigh
        touchBarHigh := na
    
    if newLowLevel
        lowTouched := false
        trackedLevelLow := levelLow
        touchBarLow := na
    
    // Detectar toque en la barra actual o barras pasadas
    if not highTouched
        if high >= levelHigh
            highTouched := true
            touchBarHigh := bar_index
    
    if not lowTouched
        if low <= levelLow
            lowTouched := true
            touchBarLow := bar_index
    
    // Dibujar solo si NO ha sido tocado
    if not highTouched and not na(levelHigh)
        int extensionTimeHigh = last_bar_time + 20 * (time - time[1])
        highLevelLine.set_first_point(chart.point.new(highBarTime, na, levelHigh))
        highLevelLine.set_second_point(chart.point.new(extensionTimeHigh, na, levelHigh))
        highLevelLabel.set_point(chart.point.new(extensionTimeHigh, na, levelHigh))
    
    if highTouched
        // Ocultar completamente
        line.delete(highLevelLine)
        label.delete(highLevelLabel)
        highLevelLine := line.new(na, na, na, na, xloc=xloc.bar_time, color=lineColor, style=convertLineStyle(styleInput))
        highLevelLabel := label.new(na, na, xloc=xloc.bar_time, text=str.format('P{0}H', tf), color=color(na), textcolor=lineColor, size=size.small, style=label.style_label_left)
    
    if not lowTouched and not na(levelLow)
        int extensionTimeLow = last_bar_time + 20 * (time - time[1])
        lowLevelLine.set_first_point(chart.point.new(lowBarTime, na, levelLow))
        lowLevelLine.set_second_point(chart.point.new(extensionTimeLow, na, levelLow))
        lowLevelLabel.set_point(chart.point.new(extensionTimeLow, na, levelLow))
    
    if lowTouched
        // Ocultar completamente
        line.delete(lowLevelLine)
        label.delete(lowLevelLabel)
        lowLevelLine := line.new(na, na, na, na, xloc=xloc.bar_time, color=lineColor, style=convertLineStyle(styleInput))
        lowLevelLabel := label.new(na, na, xloc=xloc.bar_time, text=str.format('P{0}L', tf), color=color(na), textcolor=lineColor, size=size.small, style=label.style_label_left)

if barstate.isrealtime or barstate.isconfirmed
    array.push(historicHighs, high)
    array.push(historicLows, low)
    array.push(historicTimes, time)

if barstate.islastconfirmedhistory or barstate.islast
    if enableDaily and not isHigherTF('D')
        drawMTFLevel('D', timeframe.isdaily, dailyStyle, dailyColor)
    if enableWeekly and not isHigherTF('W')
        drawMTFLevel('W', timeframe.isweekly, weeklyStyle, weeklyColor)
    if enableMonthly and not isHigherTF('M')
        drawMTFLevel('M', timeframe.ismonthly, monthlyStyle, monthlyColor)

previousBar := currentBar
currentBar := bar_index
// ============================================
// PART 5: LIQUIDITY SWEEP DETECTION
// Original implementation with equivalent sensitivity to market sweeps
// ============================================

// Inputs
sweepLookback = input.int(20, 'Pivot Lookback', minval=5, maxval=50, group='Liquidity Sweeps')
sweepCooldown = input.int(10, 'Cooldown Period', minval=0, group='Liquidity Sweeps')
showLiquidityLevels = input.bool(true, 'Show Liquidity Levels', group='Liquidity Sweeps')
enableSweepSignals = input.bool(true, 'Enable Sweep Signals', group='Liquidity Sweeps')

// Colors
bullSweepColor = input.color(color.new(color.teal, 0), 'Bullish Sweep', group='Liquidity Sweeps')
bearSweepColor = input.color(color.new(color.maroon, 0), 'Bearish Sweep', group='Liquidity Sweeps')
levelColor = input.color(color.new(color.gray, 0), 'Level Color', group='Liquidity Sweeps')

// Variables
var int lastBullSweep = 0
var int lastBearSweep = 0
var line bullSweepLine = na
var line bearSweepLine = na
var array<line> liquidityLines = array.new<line>()
var array<label> liquidityLabels = array.new<label>()
var array<float> liquidityPrices = array.new<float>()
var array<bool> liquidityTouched = array.new<bool>()

// Detectar pivotes para zonas de liquidez
pivotHigh_sweep = ta.pivothigh(high, sweepLookback, sweepLookback)
pivotLow_sweep = ta.pivotlow(low, sweepLookback, sweepLookback)

// Obtener último valor de pivote
lastPivotHigh = ta.valuewhen(not na(pivotHigh_sweep), high[sweepLookback], 0)
lastPivotLow = ta.valuewhen(not na(pivotLow_sweep), low[sweepLookback], 0)
lastPivotHighBar = ta.valuewhen(not na(pivotHigh_sweep), bar_index[sweepLookback], 0)
lastPivotLowBar = ta.valuewhen(not na(pivotLow_sweep), bar_index[sweepLookback], 0)

// Tracking de rango local
localHigh = ta.highest(high, sweepLookback)
localLow = ta.lowest(low, sweepLookback)

// Detección de sweep alcista
bullishPenetration = low < lastPivotLow and not na(lastPivotLow)
bullishRejection = close > lastPivotLow and open > lastPivotLow
bullishLocalConfirm = low == localLow
bullishCloseConfirm = ta.lowest(close, sweepLookback) >= lastPivotLow

bullishSweepDetected = bullishPenetration and bullishRejection and bullishLocalConfirm and bullishCloseConfirm

// Detección de sweep bajista
bearishPenetration = high > lastPivotHigh and not na(lastPivotHigh)
bearishRejection = close < lastPivotHigh and open < lastPivotHigh
bearishLocalConfirm = high == localHigh
bearishCloseConfirm = ta.highest(close, sweepLookback) <= lastPivotHigh

bearishSweepDetected = bearishPenetration and bearishRejection and bearishLocalConfirm and bearishCloseConfirm

// Confirmación con delay de 3 barras
bullishSweepConfirmed = bullishSweepDetected[3] and close > lastPivotLow and close[1] > lastPivotLow[1] and close[2] > lastPivotLow[2] and bar_index >= lastBullSweep + sweepCooldown

bearishSweepConfirmed = bearishSweepDetected[3] and close < lastPivotHigh and close[1] < lastPivotHigh[1] and close[2] < lastPivotHigh[2] and bar_index >= lastBearSweep + sweepCooldown

// Dibujar sweeps confirmados
if bullishSweepConfirmed
    lastBullSweep := bar_index
    line.delete(bullSweepLine)
    bullSweepLine := line.new(lastPivotLowBar, lastPivotLow, bar_index - 3, lastPivotLow, color=bullSweepColor, width=1, style=line.style_dashed)
    alert('Bullish liquidity sweep', alert.freq_once_per_bar_close)

if bearishSweepConfirmed
    lastBearSweep := bar_index
    line.delete(bearSweepLine)
    bearSweepLine := line.new(lastPivotHighBar, lastPivotHigh, bar_index - 3, lastPivotHigh, color=bearSweepColor, width=1, style=line.style_dashed)
    alert('Bearish liquidity sweep', alert.freq_once_per_bar_close)

// Plotshapes con toggle
plotshape(enableSweepSignals and bullishSweepConfirmed, 'SWEEP', location=location.belowbar, color=bullSweepColor, textcolor=bullSweepColor, text='SWEEP', style=shape.triangleup, size=size.tiny, offset=-3)
plotshape(enableSweepSignals and bearishSweepConfirmed, 'SWEEP', location=location.abovebar, color=bearSweepColor, textcolor=bearSweepColor, text='SWEEP', style=shape.triangledown, size=size.tiny, offset=-3)

// Mostrar niveles de liquidez activos
if showLiquidityLevels
    if array.size(liquidityLabels) >= 6
        for i = 0 to 2
            label.delete(array.shift(liquidityLabels))
            line.delete(array.shift(liquidityLines))
            array.shift(liquidityPrices)
            array.shift(liquidityTouched)
    
    if not na(pivotHigh_sweep)
        highLine = line.new(bar_index[sweepLookback], high[sweepLookback], bar_index + 10, high[sweepLookback], color=color.white, width=1, style=line.style_dashed)
        highLabel = label.new(bar_index[sweepLookback], high[sweepLookback], 'H', style=label.style_none, color=color(na), textcolor=color.white, size=size.tiny)
        array.push(liquidityLines, highLine)
        array.push(liquidityLabels, highLabel)
        array.push(liquidityPrices, high[sweepLookback])
        array.push(liquidityTouched, false)
    
    if not na(pivotLow_sweep)
        lowLine = line.new(bar_index[sweepLookback], low[sweepLookback], bar_index + 10, low[sweepLookback], color=color.white, width=1, style=line.style_dotted)
        lowLabel = label.new(bar_index[sweepLookback], low[sweepLookback], 'L', style=label.style_none, color=color(na), textcolor=color.white, size=size.tiny)
        array.push(liquidityLines, lowLine)
        array.push(liquidityLabels, lowLabel)
        array.push(liquidityPrices, low[sweepLookback])
        array.push(liquidityTouched, false)
    
    // Actualizar líneas existentes
    if array.size(liquidityLines) > 0
        for i = 0 to array.size(liquidityLines) - 1
            currentLine = array.get(liquidityLines, i)
            currentPrice = array.get(liquidityPrices, i)
            isTouched = array.get(liquidityTouched, i)
            
            // Verificar si el precio ha tocado este nivel
            if not isTouched
                if (high >= currentPrice and low <= currentPrice) or 
                   math.abs(high - currentPrice) < syminfo.mintick or 
                   math.abs(low - currentPrice) < syminfo.mintick
                    // Marcar como tocado y detener la extensión en este punto
                    line.set_x2(currentLine, bar_index)
                    array.set(liquidityTouched, i, true)
                else
                    // Si no ha sido tocado, continuar extendiendo
                    line.set_x2(currentLine, bar_index + 5)
            // Si ya fue tocado, no hacer nada (mantener la línea fija)
// ============================================
// PART 6: VOLUMIZED ORDER BLOCKS
// ============================================

const bool DEBUG = false
const int maxBoxesCount = 500
const float overlapThresholdPercentage = 0
const int maxDistanceToLastBar = 1750
const int maxOrderBlocks = 30

showInvalidated = input.bool(true, "Show Historic Zones", group="Order Blocks", display=display.none)
OBsEnabled = true
orderBlockVolumetricInfo = input.bool(true, "Volumetric Info", group="Order Blocks", inline="EV", display=display.none)
obEndMethod = input.string("Wick", "Zone Invalidation", options=["Wick", "Close"], group="Order Blocks", display=display.none)
combineOBs = DEBUG ? input.bool(true, "Combine Zones", group="Order Blocks", display=display.none) : true
maxATRMult = DEBUG ? input.float(3.5, "Max Atr Multiplier", group="Order Blocks") : 3.5
swingLength = input.int(50, 'Swing Length', minval=3, tooltip="Swing length is used when finding order block formations. Smaller values will result in finding smaller order blocks.", group="Order Blocks", display=display.none)
zoneCount = input.string("Low", 'Zone Count', options=["High", "Medium", "Low", "One"], tooltip="Number of Order Block Zones to be rendered. Higher options will result in older Order Blocks shown.", group="Order Blocks", display=display.none)
bullOrderBlockColor = input(#d9770680, 'Bullish', inline='obColor', group='Order Blocks', display=display.none)
bearOrderBlockColor = input(#6b728080, 'Bearish', inline='obColor', group='Order Blocks', display=display.none)

bullishOrderBlocks = zoneCount == "One" ? 1 : zoneCount == "Low" ? 3 : zoneCount == "Medium" ? 5 : 10
bearishOrderBlocks = zoneCount == "One" ? 1 : zoneCount == "Low" ? 3 : zoneCount == "Medium" ? 5 : 10

timeframe1Enabled = true
timeframe1 = ""

textColor = input.color(#ffffff80, "Text Color", group="Order Blocks")
extendZonesBy = DEBUG ? input.int(15, "Extend Zones", group="Order Blocks", minval=1, maxval=30, inline="ExtendZones") : 15
extendZonesDynamic = DEBUG ? input.bool(true, "Dynamic", group="Order Blocks", inline="ExtendZones") : true
combinedText = DEBUG ? input.bool(false, "Combined Text", group="Order Blocks", inline="CombinedColor") : false
volumeBarsPlace = DEBUG ? input.string("Left", "Show Volume Bars At", options=["Left", "Right"], group="Order Blocks", inline="volumebars") : "Left"
mirrorVolumeBars = DEBUG ? input.bool(true, "Mirror Volume Bars", group="Order Blocks", inline="volumebars") : true

volumeBarsLeftSide = (volumeBarsPlace == "Left")
extendZonesByTime = extendZonesBy * timeframe.in_seconds(timeframe.period) * 1000

atr = ta.atr(10)

type orderBlockInfo
    float top
    float bottom
    float obVolume
    string obType
    int startTime
    float bbVolume
    float obLowVolume
    float obHighVolume
    bool breaker
    int breakTime
    string timeframeStr
    bool disabled = false
    string combinedTimeframesStr = na
    bool combined = false

type orderBlock
    orderBlockInfo info
    bool isRendered = false
    box orderBox = na
    box breakerBox = na
    line orderBoxLineTop = na
    line orderBoxLineBottom = na
    line breakerBoxLineTop = na
    line breakerBoxLineBottom = na
    box orderBoxText = na
    box orderBoxPositive = na
    box orderBoxNegative = na
    line orderSeperator = na
    line orderTextSeperator = na

createOrderBlock(orderBlockInfo orderBlockInfoF) =>
    orderBlock newOrderBlock = orderBlock.new(orderBlockInfoF)
    newOrderBlock

safeDeleteOrderBlock(orderBlock orderBlockF) =>
    orderBlockF.isRendered := false
    box.delete(orderBlockF.orderBox)
    box.delete(orderBlockF.breakerBox)
    box.delete(orderBlockF.orderBoxText)
    box.delete(orderBlockF.orderBoxPositive)
    box.delete(orderBlockF.orderBoxNegative)
    line.delete(orderBlockF.orderBoxLineTop)
    line.delete(orderBlockF.orderBoxLineBottom)
    line.delete(orderBlockF.breakerBoxLineTop)
    line.delete(orderBlockF.breakerBoxLineBottom)
    line.delete(orderBlockF.orderSeperator)
    line.delete(orderBlockF.orderTextSeperator)

type timeframeInfo
    int index = na
    string timeframeStr = na
    bool isEnabled = false
    orderBlockInfo[] bullishOrderBlocksList = na
    orderBlockInfo[] bearishOrderBlocksList = na

newTimeframeInfo(index, timeframeStr, isEnabled) =>
    newTFInfo = timeframeInfo.new()
    newTFInfo.index := index
    newTFInfo.isEnabled := isEnabled
    newTFInfo.timeframeStr := timeframeStr
    newTFInfo

type obSwing
    int x = na
    float y = na
    float swingVolume = na
    bool crossed = false

var timeframeInfo[] timeframeInfos = array.from(newTimeframeInfo(1, timeframe1, timeframe1Enabled))
var bullishOrderBlocksList = array.new<orderBlockInfo>(0)
var bearishOrderBlocksList = array.new<orderBlockInfo>(0)
var allOrderBlocksList = array.new<orderBlock>(0)

moveLine(_line, _x, _y, _x2) =>
    line.set_xy1(_line, _x, _y)
    line.set_xy2(_line, _x2, _y)

moveBox(_box, _topLeftX, _topLeftY, _bottomRightX, _bottomRightY) =>
    box.set_lefttop(_box, _topLeftX, _topLeftY)
    box.set_rightbottom(_box, _bottomRightX, _bottomRightY)

isTimeframeLower(timeframe1F, timeframe2F) =>
    timeframe.in_seconds(timeframe1F) < timeframe.in_seconds(timeframe2F)

getMinTimeframe(timeframe1F, timeframe2F) =>
    if isTimeframeLower(timeframe1F, timeframe2F)
        timeframe1F
    else
        timeframe2F

getMaxTimeframe(timeframe1F, timeframe2F) =>
    if isTimeframeLower(timeframe1F, timeframe2F)
        timeframe2F
    else
        timeframe1F

formatTimeframeString(formatTimeframe) =>
    timeframeF = formatTimeframe == "" ? timeframe.period : formatTimeframe
    if str.contains(timeframeF, "D") or str.contains(timeframeF, "W") or str.contains(timeframeF, "S") or str.contains(timeframeF, "M")
        timeframeF
    else
        seconds = timeframe.in_seconds(timeframeF)
        if seconds >= 3600
            hourCount = int(seconds / 3600)
            str.tostring(hourCount) + " Hour" + (hourCount > 1 ? "s" : "")
        else
            timeframeF + " Min"

betterCross(s1, s2) =>
    string ret = na
    if s1 >= s2 and s1[1] < s2
        ret := "Bull"
    if s1 < s2 and s1[1] >= s2
        ret := "Bear"
    ret

colorWithTransparency(colorF, transparencyX) =>
    color.new(colorF, color.t(colorF) * transparencyX)

createOBBox(boxColor, transparencyX = 1.0, xlocType = xloc.bar_time) =>
    box.new(na, na, na, na, text_size=size.normal, xloc=xlocType, extend=extend.none, bgcolor=colorWithTransparency(boxColor, transparencyX), text_color=textColor, text_halign=text.align_center, border_color=#00000000)

renderOrderBlock(orderBlock ob) =>
    orderBlockInfo info = ob.info
    ob.isRendered := true
    orderColor = ob.info.obType == "Bull" ? bullOrderBlockColor : bearOrderBlockColor
    if OBsEnabled and (not false or not (false and info.breaker)) and not (not showInvalidated and info.breaker)
        ob.orderBox := createOBBox(orderColor, 1.5)
        if ob.info.combined
            ob.orderBox.set_bgcolor(colorWithTransparency(orderColor, 1.1))
        ob.orderBoxText := createOBBox(color.new(color.white, 100))
        if orderBlockVolumetricInfo
            ob.orderBoxPositive := createOBBox(bullOrderBlockColor)
            ob.orderBoxNegative := createOBBox(bearOrderBlockColor)
            ob.orderSeperator := line.new(na, na, na, na, xloc.bar_time, extend.none, textColor, line.style_dashed, 1)
            ob.orderTextSeperator := line.new(na, na, na, na, xloc.bar_time, extend.none, textColor, line.style_solid, 1)
        zoneSize = extendZonesDynamic ? na(info.breakTime) ? extendZonesByTime : (info.breakTime - info.startTime) : extendZonesByTime
        if na(info.breakTime)
            zoneSize := (time + 1) - info.startTime
        startX = volumeBarsLeftSide ? info.startTime : info.startTime + zoneSize - zoneSize / 3
        maxEndX = volumeBarsLeftSide ? info.startTime + zoneSize / 3 : info.startTime + zoneSize
        moveBox(ob.orderBox, info.startTime, info.top, info.startTime + zoneSize, info.bottom)
        moveBox(ob.orderBoxText, volumeBarsLeftSide ? maxEndX : info.startTime, info.top, volumeBarsLeftSide ? info.startTime + zoneSize : startX, info.bottom)
        percentage = int((math.min(info.obHighVolume, info.obLowVolume) / math.max(info.obHighVolume, info.obLowVolume)) * 100.0)
        OBText = (na(ob.info.combinedTimeframesStr) ? formatTimeframeString(ob.info.timeframeStr) : ob.info.combinedTimeframesStr) + (ob.info.breaker ? " BB" : " OB")
        box.set_text(ob.orderBoxText, (orderBlockVolumetricInfo ? str.tostring(ob.info.obVolume, format.volume) + " (" + str.tostring(percentage) + "%)\n" : "") + (combinedText and ob.info.combined ? "[Combined]\n" : "") + OBText)
        if orderBlockVolumetricInfo
            showHighLowBoxText = false
            curEndXHigh = int(math.ceil((info.obHighVolume / info.obVolume) * (maxEndX - startX) + startX))
            curEndXLow = int(math.ceil((info.obLowVolume / info.obVolume) * (maxEndX - startX) + startX))
            moveBox(ob.orderBoxPositive, mirrorVolumeBars ? startX : curEndXLow, info.top, mirrorVolumeBars ? curEndXHigh : maxEndX, (info.bottom + info.top) / 2)
            box.set_text(ob.orderBoxPositive, showHighLowBoxText ? str.tostring(info.obHighVolume, format.volume) : "")
            moveBox(ob.orderBoxNegative, mirrorVolumeBars ? startX : curEndXHigh, info.bottom, mirrorVolumeBars ? curEndXLow : maxEndX, (info.bottom + info.top) / 2)
            box.set_text(ob.orderBoxNegative, showHighLowBoxText ? str.tostring(info.obLowVolume, format.volume) : "")
            moveLine(ob.orderSeperator, volumeBarsLeftSide ? startX : maxEndX, (info.bottom + info.top) / 2, volumeBarsLeftSide ? maxEndX : startX)
            line.set_xy1(ob.orderTextSeperator, volumeBarsLeftSide ? maxEndX : startX, info.top)
            line.set_xy2(ob.orderTextSeperator, volumeBarsLeftSide ? maxEndX : startX, info.bottom)

findOBSwings(len) =>
    var swingType = 0
    var obSwing top = obSwing.new(na, na)
    var obSwing bottom = obSwing.new(na, na)
    upper = ta.highest(len)
    lower = ta.lowest(len)
    swingType := high[len] > upper ? 0 : low[len] < lower ? 1 : swingType
    if swingType == 0 and swingType[1] != 0
        top := obSwing.new(bar_index[len], high[len], volume[len])
    if swingType == 1 and swingType[1] != 1
        bottom := obSwing.new(bar_index[len], low[len], volume[len])
    [top, bottom]

[top, btm] = findOBSwings(swingLength)

findOrderBlocks() =>
    if bar_index > last_bar_index - maxDistanceToLastBar
        useBody = false
        max = useBody ? math.max(close, open) : high
        min = useBody ? math.min(close, open) : low
        bullishBreaked = 0
        if bullishOrderBlocksList.size() > 0
            for i = bullishOrderBlocksList.size() - 1 to 0
                currentOB = bullishOrderBlocksList.get(i)
                if not currentOB.breaker
                    if math.min(open, close) < currentOB.bottom
                        currentOB.breaker := true
                        currentOB.breakTime := time
                        currentOB.bbVolume := volume
                else
                    if high > currentOB.top
                        bullishOrderBlocksList.remove(i)
                    else if i < bullishOrderBlocks and top.y < currentOB.top and top.y > currentOB.bottom
                        bullishBreaked := 1
        if close > top.y and not top.crossed
            top.crossed := true
            boxBtm = max[1]
            boxTop = min[1]
            boxLoc = time[1]
            for i = 1 to (bar_index - top.x) - 1
                boxBtm := math.min(min[i], boxBtm)
                boxTop := boxBtm == min[i] ? max[i] : boxTop
                boxLoc := boxBtm == min[i] ? time[i] : boxLoc
            newOrderBlockInfo = orderBlockInfo.new(boxTop, boxBtm, volume + volume[1] + volume[2], "Bull", boxLoc)
            newOrderBlockInfo.obLowVolume := volume[2]
            newOrderBlockInfo.obHighVolume := volume + volume[1]
            obSize = math.abs(newOrderBlockInfo.top - newOrderBlockInfo.bottom)
            if obSize <= atr * maxATRMult
                bullishOrderBlocksList.unshift(newOrderBlockInfo)
                if bullishOrderBlocksList.size() > maxOrderBlocks
                    bullishOrderBlocksList.pop()
        bearishBreaked = 0
        if bearishOrderBlocksList.size() > 0
            for i = bearishOrderBlocksList.size() - 1 to 0
                currentOB = bearishOrderBlocksList.get(i)
                if not currentOB.breaker
                    if math.max(open, close) > currentOB.top
                        currentOB.breaker := true
                        currentOB.breakTime := time
                        currentOB.bbVolume := volume
                else
                    if low < currentOB.bottom
                        bearishOrderBlocksList.remove(i)
                    else if i < bearishOrderBlocks and btm.y > currentOB.bottom and btm.y < currentOB.top
                        bearishBreaked := 1
        if close < btm.y and not btm.crossed
            btm.crossed := true
            boxBtm = min[1]
            boxTop = max[1]
            boxLoc = time[1]
            for i = 1 to (bar_index - btm.x) - 1
                boxTop := math.max(max[i], boxTop)
                boxBtm := boxTop == max[i] ? min[i] : boxBtm
                boxLoc := boxTop == max[i] ? time[i] : boxLoc
            newOrderBlockInfo = orderBlockInfo.new(boxTop, boxBtm, volume + volume[1] + volume[2], "Bear", boxLoc)
            newOrderBlockInfo.obLowVolume := volume + volume[1]
            newOrderBlockInfo.obHighVolume := volume[2]
            obSize = math.abs(newOrderBlockInfo.top - newOrderBlockInfo.bottom)
            if obSize <= atr * maxATRMult
                bearishOrderBlocksList.unshift(newOrderBlockInfo)
                if bearishOrderBlocksList.size() > maxOrderBlocks
                    bearishOrderBlocksList.pop()
    true

areaOfOB(orderBlockInfo OBInfoF) =>
    float XA1 = OBInfoF.startTime
    float XA2 = na(OBInfoF.breakTime) ? time + 1 : OBInfoF.breakTime
    float YA1 = OBInfoF.top
    float YA2 = OBInfoF.bottom
    float edge1 = math.sqrt((XA2 - XA1) * (XA2 - XA1) + (YA2 - YA2) * (YA2 - YA2))
    float edge2 = math.sqrt((XA2 - XA2) * (XA2 - XA2) + (YA2 - YA1) * (YA2 - YA1))
    float totalArea = edge1 * edge2
    totalArea

doOBsTouch(orderBlockInfo OBInfo1, orderBlockInfo OBInfo2) =>
    float XA1 = OBInfo1.startTime
    float XA2 = na(OBInfo1.breakTime) ? time + 1 : OBInfo1.breakTime
    float YA1 = OBInfo1.top
    float YA2 = OBInfo1.bottom
    float XB1 = OBInfo2.startTime
    float XB2 = na(OBInfo2.breakTime) ? time + 1 : OBInfo2.breakTime
    float YB1 = OBInfo2.top
    float YB2 = OBInfo2.bottom
    float intersectionArea = math.max(0, math.min(XA2, XB2) - math.max(XA1, XB1)) * math.max(0, math.min(YA1, YB1) - math.max(YA2, YB2))
    float unionArea = areaOfOB(OBInfo1) + areaOfOB(OBInfo2) - intersectionArea
    float overlapPercentage = (intersectionArea / unionArea) * 100.0
    if overlapPercentage > overlapThresholdPercentage
        true
    else
        false

isOBValid(orderBlockInfo OBInfo) =>
    valid = true
    if OBInfo.disabled
        valid := false
    valid

combineOBsFunc() =>
    if allOrderBlocksList.size() > 0
        lastCombinations = 999
        while lastCombinations > 0
            lastCombinations := 0
            for i = 0 to allOrderBlocksList.size() - 1
                curOB1 = allOrderBlocksList.get(i)
                for j = 0 to allOrderBlocksList.size() - 1
                    curOB2 = allOrderBlocksList.get(j)
                    if i == j
                        continue
                    if not isOBValid(curOB1.info) or not isOBValid(curOB2.info)
                        continue
                    if curOB1.info.obType != curOB2.info.obType
                        continue
                    if doOBsTouch(curOB1.info, curOB2.info)
                        curOB1.info.disabled := true
                        curOB2.info.disabled := true
                        orderBlock newOB = createOrderBlock(orderBlockInfo.new(math.max(curOB1.info.top, curOB2.info.top), math.min(curOB1.info.bottom, curOB2.info.bottom), curOB1.info.obVolume + curOB2.info.obVolume, curOB1.info.obType))
                        newOB.info.startTime := math.min(curOB1.info.startTime, curOB2.info.startTime)
                        newOB.info.breakTime := math.max(nz(curOB1.info.breakTime), nz(curOB2.info.breakTime))
                        newOB.info.breakTime := newOB.info.breakTime == 0 ? na : newOB.info.breakTime
                        newOB.info.timeframeStr := curOB1.info.timeframeStr
                        newOB.info.obVolume := curOB1.info.obVolume + curOB2.info.obVolume
                        newOB.info.obLowVolume := curOB1.info.obLowVolume + curOB2.info.obLowVolume
                        newOB.info.obHighVolume := curOB1.info.obHighVolume + curOB2.info.obHighVolume
                        newOB.info.bbVolume := nz(curOB1.info.bbVolume, 0) + nz(curOB2.info.bbVolume, 0)
                        newOB.info.breaker := curOB1.info.breaker or curOB2.info.breaker
                        newOB.info.combined := true
                        if timeframe.in_seconds(curOB1.info.timeframeStr) != timeframe.in_seconds(curOB2.info.timeframeStr)
                            newOB.info.combinedTimeframesStr := (na(curOB1.info.combinedTimeframesStr) ? formatTimeframeString(curOB1.info.timeframeStr) : curOB1.info.combinedTimeframesStr) + " & " + (na(curOB2.info.combinedTimeframesStr) ? formatTimeframeString(curOB2.info.timeframeStr) : curOB2.info.combinedTimeframesStr)
                        allOrderBlocksList.unshift(newOB)
                        lastCombinations += 1

reqSeq(timeframeStr) =>
    [bullishOrderBlocksListF, bearishOrderBlocksListF] = request.security(syminfo.tickerid, timeframeStr, [bullishOrderBlocksList, bearishOrderBlocksList])
    [bullishOrderBlocksListF, bearishOrderBlocksListF]

getTFData(timeframeInfo timeframeInfoF, timeframeStr) =>
    if not isTimeframeLower(timeframeInfoF.timeframeStr, timeframe.period) and timeframeInfoF.isEnabled
        [bullishOrderBlocksListF, bearishOrderBlocksListF] = reqSeq(timeframeStr)
        [bullishOrderBlocksListF, bearishOrderBlocksListF]
    else
        [na, na]

handleTimeframeInfo(timeframeInfo timeframeInfoF, bullishOrderBlocksListF, bearishOrderBlocksListF) =>
    if not isTimeframeLower(timeframeInfoF.timeframeStr, timeframe.period) and timeframeInfoF.isEnabled
        timeframeInfoF.bullishOrderBlocksList := bullishOrderBlocksListF
        timeframeInfoF.bearishOrderBlocksList := bearishOrderBlocksListF

handleOrderBlocksFinal() =>
    if allOrderBlocksList.size() > 0
        for i = 0 to allOrderBlocksList.size() - 1
            safeDeleteOrderBlock(allOrderBlocksList.get(i))
    allOrderBlocksList.clear()
    for i = 0 to timeframeInfos.size() - 1
        curTimeframe = timeframeInfos.get(i)
        if not curTimeframe.isEnabled
            continue
        if curTimeframe.bullishOrderBlocksList.size() > 0
            for j = 0 to math.min(curTimeframe.bullishOrderBlocksList.size() - 1, bullishOrderBlocks - 1)
                orderBlockInfoF = curTimeframe.bullishOrderBlocksList.get(j)
                orderBlockInfoF.timeframeStr := curTimeframe.timeframeStr
                allOrderBlocksList.unshift(createOrderBlock(orderBlockInfo.copy(orderBlockInfoF)))
        if curTimeframe.bearishOrderBlocksList.size() > 0
            for j = 0 to math.min(curTimeframe.bearishOrderBlocksList.size() - 1, bearishOrderBlocks - 1)
                orderBlockInfoF = curTimeframe.bearishOrderBlocksList.get(j)
                orderBlockInfoF.timeframeStr := curTimeframe.timeframeStr
                allOrderBlocksList.unshift(createOrderBlock(orderBlockInfo.copy(orderBlockInfoF)))
    if combineOBs
        combineOBsFunc()
    if allOrderBlocksList.size() > 0
        for i = 0 to allOrderBlocksList.size() - 1
            curOB = allOrderBlocksList.get(i)
            if isOBValid(curOB.info)
                renderOrderBlock(curOB)

findOrderBlocks()

[bullishOrderBlocksListTimeframe1, bearishOrderBlocksListTimeframe1] = getTFData(timeframeInfos.get(0), timeframe1)

if barstate.isconfirmed
    handleTimeframeInfo(timeframeInfos.get(0), bullishOrderBlocksListTimeframe1, bearishOrderBlocksListTimeframe1)
    handleOrderBlocksFinal()

// ============================================
// PART 4: BUY/SELL SIGNALS - STRUCTURE ALIGNMENT AFTER OB TOUCH
// ============================================

labels = input(0, 'Labels Transparency', group='OB Touch Signals')
buycolor = input.color(#03ff85, 'Buy Color', group='OB Touch Signals')
sellcolor = input.color(#fc0808, 'Sell Color', group='OB Touch Signals')
labelsize__0 = input.int(2, 'Label Size', minval=1, maxval=5, group='OB Touch Signals')
zoneTolerancePercent = input.float(0.1, 'Zone Touch Tolerance %', minval=0, maxval=1, step=0.05, group='OB Touch Signals')
enableOBSignals = input.bool(true, 'Enable OB Touch Signals', group='OB Touch Signals')

labelsize = switch labelsize__0
    1 => size.tiny
    2 => size.small
    3 => size.normal
    4 => size.large
    5 => size.huge

// Tipo para rastrear OBs tocados esperando alineación
type PendingOBSignal
    float top
    float bottom
    string obType
    int touchBar
    bool signalSent

var array<PendingOBSignal> pendingSignals = array.new<PendingOBSignal>(0)

// Función para verificar si el precio está tocando un OB
getPriceInOB(string type) =>
    int foundIndex = -1
    float foundTop = na
    float foundBottom = na
    if allOrderBlocksList.size() > 0
        for i = 0 to allOrderBlocksList.size() - 1
            ob = allOrderBlocksList.get(i)
            if isOBValid(ob.info) and ob.info.obType == type and not ob.info.breaker
                obTop = ob.info.top
                obBottom = ob.info.bottom
                tolerance = (obTop - obBottom) * zoneTolerancePercent
                if (type == "Bull" and low <= obTop + tolerance and high >= obBottom - tolerance) or
                   (type == "Bear" and high >= obBottom - tolerance and low <= obTop + tolerance)
                    foundIndex := i
                    foundTop := obTop
                    foundBottom := obBottom
                    break
    [foundIndex, foundTop, foundBottom]

// Función para buscar una señal pendiente (incluyendo las ya enviadas)
findPendingSignal(float top, float bottom, string obType) =>
    PendingOBSignal found = na
    if pendingSignals.size() > 0
        for i = 0 to pendingSignals.size() - 1
            pending = pendingSignals.get(i)
            if pending.obType == obType
                topMatch = math.abs(pending.top - top) / top < 0.001
                bottomMatch = math.abs(pending.bottom - bottom) / bottom < 0.001
                if topMatch and bottomMatch
                    found := pending
                    break
    found

// Función para crear una nueva señal pendiente
createPendingSignal(float top, float bottom, string obType) =>
    newPending = PendingOBSignal.new(top, bottom, obType, bar_index, false)
    pendingSignals.push(newPending)
    if pendingSignals.size() > 20
        pendingSignals.shift()
    newPending

// Verificar si las estructuras están alineadas
bullishStructuresAligned = trendDirection == 1 and iTrend == 1
bearishStructuresAligned = trendDirection == -1 and iTrend == -1

if enableOBSignals
    // PASO 1: Detectar toques a OBs (sin pintar señal)
    [bullOBIndex, bullOBTop, bullOBBottom] = getPriceInOB("Bull")
    [bearOBIndex, bearOBTop, bearOBBottom] = getPriceInOB("Bear")
    
    // Registrar toque a OB alcista (demanda)
    if bullOBIndex >= 0
        pending = findPendingSignal(bullOBTop, bullOBBottom, "Bull")
        if na(pending) and trendDirection == 1
            // Crear nueva señal pendiente solo si estructura externa es alcista
            createPendingSignal(bullOBTop, bullOBBottom, "Bull")
    
    // Registrar toque a OB bajista (oferta)
    if bearOBIndex >= 0
        pending = findPendingSignal(bearOBTop, bearOBBottom, "Bear")
        if na(pending) and trendDirection == -1
            // Crear nueva señal pendiente solo si estructura externa es bajista
            createPendingSignal(bearOBTop, bearOBBottom, "Bear")
    
    // PASO 2 y 3: Verificar alineación y pintar señales
    if pendingSignals.size() > 0
        for i = pendingSignals.size() - 1 to 0
            pending = pendingSignals.get(i)
            
            if not pending.signalSent
                // Verificar que no haya pasado demasiado tiempo (máximo 50 barras)
                if bar_index - pending.touchBar <= 50
                    
                    // SEÑAL DE COMPRA: OB alcista tocado + estructuras alineadas alcistas
                    if pending.obType == "Bull" and bullishStructuresAligned
                        label.new(bar_index, low, 'COMPRA',
                                  xloc.bar_index, yloc.price,
                                  color.new(buycolor, labels),
                                  label.style_label_up,
                                  color.new(color.black, labels),
                                  labelsize)
                        pending.signalSent := true
                        alert('COMPRA signal - Structures aligned after OB touch!', alert.freq_once_per_bar)
                    
                    // SEÑAL DE VENTA: OB bajista tocado + estructuras alineadas bajistas
                    else if pending.obType == "Bear" and bearishStructuresAligned
                        label.new(bar_index, high, 'VENTA',
                                  xloc.bar_index, yloc.price,
                                  color.new(sellcolor, labels),
                                  label.style_label_down,
                                  color.new(color.black, labels),
                                  labelsize)
                        pending.signalSent := true
                        alert('VENTA signal - Structures aligned after OB touch!', alert.freq_once_per_bar)
                
                else
                    // Expirar señales antiguas sin enviar
                    pendingSignals.remove(i)
            else
                // Limpiar señales ya enviadas después de 10 barras
                if bar_index - pending.touchBar > 60
                    pendingSignals.remove(i)
// ============================================
// PART 7: EQUAL HIGHS/LOWS (EQH/EQL)
// ============================================

// Configuración fija (no modificable desde settings)
pivotLengthEQL = 3
confluenceAtrLength = 200
threshold = 0.10
waitForConfirmation = true

goldenColor = color.rgb(255, 136, 0)

atrEQL = ta.atr(confluenceAtrLength)
ph_eql = ta.pivothigh(pivotLengthEQL, 1)
pl_eql = ta.pivotlow(pivotLengthEQL, 1)

if waitForConfirmation
    ph_eql := ta.pivothigh(pivotLengthEQL, pivotLengthEQL)
    pl_eql := ta.pivotlow(pivotLengthEQL, pivotLengthEQL)
    pl_eql

var previousHigh = 0.
var highLocX = 0

if bool(ph_eql)
    max = math.max(ph_eql, previousHigh)
    min = math.min(ph_eql, previousHigh)
    if max < min + atrEQL * threshold
        drawHighLine = line.new(highLocX, previousHigh, waitForConfirmation ? bar_index - pivotLengthEQL : bar_index - 1, ph_eql, color=goldenColor, style=line.style_solid, width=1)
        drawHighLabel = label.new(int(math.avg(waitForConfirmation ? bar_index - pivotLengthEQL : bar_index - 1, highLocX)), ph_eql, '$', color=#00000000, textcolor=goldenColor, style=label.style_label_down, size=size.normal)
        drawHighLabel
    previousHigh := ph_eql
    highLocX := waitForConfirmation ? bar_index - pivotLengthEQL : bar_index - 1
    highLocX

var previousLow = 0.
var lowLocX = 0

if bool(pl_eql)
    max = math.max(pl_eql, previousLow)
    min = math.min(pl_eql, previousLow)
    if min > max - atrEQL * threshold
        drawLowLine = line.new(lowLocX, previousLow, waitForConfirmation ? bar_index - pivotLengthEQL : bar_index - 1, pl_eql, color=goldenColor, style=line.style_solid, width=1)
        drawLowLabel = label.new(int(math.avg(waitForConfirmation ? bar_index - pivotLengthEQL : bar_index - 1, lowLocX)), pl_eql, '$', color=#00000000, textcolor=goldenColor, style=label.style_label_up, size=size.normal)
        drawLowLabel
    previousLow := pl_eql
    lowLocX := waitForConfirmation ? bar_index - pivotLengthEQL : bar_index - 1

plot(na)

// ============================================
