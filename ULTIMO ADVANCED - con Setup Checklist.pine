TF_1_Bul_Bos_Col = input.color(defval = color.white, title = "Bullish Bos/Mss Color", group = Timeframe_1_Group, inline = "TF 1 Color")
TF_1_Bear_Bos_Col = input.color(defval = color.white, title = "Bearish Bos/Mss Color", group = Timeframe_1_Group, inline = "TF 1 Color")
